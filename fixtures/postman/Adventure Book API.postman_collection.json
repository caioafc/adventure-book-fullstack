    {
      "name": "Adventure walkthrough",
      "description": "Import Signal from Ember Station and run these requests in order. The collection saves book and section IDs from each response.",
      "item": [
        {
          "name": "Find the demo book",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books?search=Signal+from+Ember+Station&page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Signal from Ember Station"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            },
            "description": "Saves the book ID from the catalogue. Import demo-signal-from-ember-station.json first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.equal(200); });",
                  "pm.test(\"Verify Find the demo book\", function () {",
                  "    const body = pm.response.json();",
                  "    const demo = body.content.find(book => book.title === \"Signal from Ember Station\");",
                  "    pm.expect(Boolean(demo)).to.equal(true);",
                  "    pm.expect(Number.isSafeInteger(demo.id) && demo.id > 0).to.equal(true);",
                  "    pm.collectionVariables.set(\"bookId\", String(demo.id));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get book details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "{{bookId}}"
              ]
            },
            "description": "Verifies the book summary and saves beginningSectionId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.equal(200); });",
                  "pm.test(\"Verify Get book details\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.equal(Number(pm.collectionVariables.get(\"bookId\")));",
                  "    pm.expect(body.title).to.equal(\"Signal from Ember Station\");",
                  "    pm.expect(body.author).to.equal(\"Leila North\");",
                  "    pm.expect(body.difficulty).to.equal(\"HARD\");",
                  "    pm.expect(Number.isSafeInteger(body.beginningSectionId) && body.beginningSectionId > 0).to.equal(true);",
                  "    pm.collectionVariables.set(\"beginningSectionId\", String(body.beginningSectionId));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get the beginning section",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}/sections/{{beginningSectionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "{{bookId}}",
                "sections",
                "{{beginningSectionId}}"
              ]
            },
            "description": "Checks choice order, damage, and healing. Saves the medical bay destination."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.equal(200); });",
                  "pm.test(\"Verify Get the beginning section\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.equal(Number(pm.collectionVariables.get(\"beginningSectionId\")));",
                  "    pm.expect(body.type).to.equal(\"BEGIN\");",
                  "    pm.expect(typeof body.text === \"string\" && body.text.trim().length > 0).to.equal(true);",
                  "    pm.expect(Array.isArray(body.options)).to.equal(true);",
                  "    pm.expect(body.options.length).to.equal(2);",
                  "    pm.expect(body.options[0].description).to.equal(\"Cross the damaged gantry\");",
                  "    pm.expect(body.options[1].description).to.equal(\"Check the medical bay first\");",
                  "    pm.expect(body.options[0].consequence.type).to.equal(\"LOSE_HEALTH\");",
                  "    pm.expect(body.options[0].consequence.value).to.equal(4);",
                  "    pm.expect(body.options[0].consequence.text).to.equal(\"A loose panel strikes your suit.\");",
                  "    pm.expect(body.options[1].consequence.type).to.equal(\"GAIN_HEALTH\");",
                  "    pm.expect(body.options[1].consequence.value).to.equal(4);",
                  "    pm.expect(body.options[1].consequence.text).to.equal(\"An emergency patch treats your injuries.\");",
                  "    pm.expect(Number.isSafeInteger(body.options[1].gotoId) && body.options[1].gotoId > 0).to.equal(true);",
                  "    pm.collectionVariables.set(\"medicalBayId\", String(body.options[1].gotoId));",
                  "    pm.collectionVariables.set(\"beginningResponse\", JSON.stringify(body));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Read the medical bay",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}/sections/{{medicalBayId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "{{bookId}}",
                "sections",
                "{{medicalBayId}}"
              ]
            },
            "description": "Verifies the return choice leads to the same beginning ID and saves the communications destination."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
