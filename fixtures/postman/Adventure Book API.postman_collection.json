        {
          "name": "List books — default pagination",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ]
            },
            "description": "Returns page 0 with size 10, without filters."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Catalogue response contains pagination metadata\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.content).to.be.an(\"array\");",
                  "    [\"page\", \"size\", \"totalElements\", \"totalPages\"].forEach(key => pm.expect(body[key]).to.be.a(\"number\"));",
                  "    pm.expect(body.last).to.be.a(\"boolean\");",
                  "});"
                ]
              }
            }
          ],
          "response": []
