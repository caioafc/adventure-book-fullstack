{
  "info": {
    "name": "Adventure Book API",
    "description": "Tests for GET /api/books, GET /api/books/{bookId}, and GET /api/books/{bookId}/sections/{sectionId}. Start the backend, import the collection, and set baseUrl if needed. Catalogue and Edge cases can run with an empty database. For the Adventure walkthrough and Adventure request errors, queue demo-signal-from-ember-station.json from fixtures/books/demo into books/ready and run the requests in order. The walkthrough saves IDs returned by the API. Page numbers start at zero. Error requests verify the HTTP status, code, and description.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
